    "Allow AuthBackup to use the camera in Settings, or choose a screenshot instead.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите AuthBackup доступ к камере в Настройках или выберите скриншот."
          }
        }
      }
    },
    "Already saved": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже сохранён"
          }
        }
      }
    },
    "An encrypted backup or a JSON backup from AuthBackup, or a text file with otpauth:// links from another authenticator.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифрованный или JSON-бэкап AuthBackup либо текстовый файл со ссылками otpauth:// из другого аутентификатора."
          }
        }
      }
    },
    "Anyone who sees this QR code or key can make your codes. Show it only to scan it into your own authenticator.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой, кто увидит этот QR-код или ключ, сможет получать ваши коды. Показывайте его, только чтобы отсканировать в свой аутентификатор."
          }
        }
      }
    },
    "At least %lld characters.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не короче %lld символов."
          }
        }
