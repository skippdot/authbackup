            "value": "В этом QR-коде нет ключа двухфакторной аутентификации."
          }
        }
      }
    },
    "This backup was made by a newer version and cannot be opened here.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот бэкап сделан более новой версией, здесь его не открыть."
          }
        }
      }
    },
    "This is not a Google Authenticator export.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не экспорт Google Authenticator."
          }
        }
