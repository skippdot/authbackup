      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокировать"
          }
        }
      }
    },
    "Unlock this device and open AuthBackup again. Nothing was changed.": {
      "localizations": {
        "ru": {
          "stringUnit": {
