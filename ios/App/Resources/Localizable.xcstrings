    },
    "This key is already saved": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот ключ уже сохранён"
          }
        }
      }
    },
    "This password is needed to open the file. It cannot be recovered: keep it in your password manager. %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без этого пароля файл не открыть, восстановить его нельзя: сохраните его в менеджере паролей. %@"
          }
        }
      }
    },
