    },
    "The image cannot be opened.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть изображение."
          }
        }
      }
    },
    "The key is the text the website shows next to the QR code, usually 16 or 32 letters and digits. Spaces do not matter.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ — это текст, который сайт показывает рядом с QR-кодом, обычно 16 или 32 буквы и цифры. Пробелы не важны."
          }
        }
      }
    },
    "The key may contain only the letters A–Z and the digits 2–7.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ может содержать только буквы A–Z и цифры 2–7."
          }
        }
      }
    },
    "The link has no valid secret key.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ссылке нет корректного секретного ключа."
          }
        }
      }
    },
