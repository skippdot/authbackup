    },
    "AuthBackup": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AuthBackup"
          }
        }
      }
    },
    "AuthBackup has no servers, no accounts and no analytics. The app never connects to the internet.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У AuthBackup нет серверов, учётных записей и аналитики. Приложение никогда не выходит в интернет."
          }
        }
      }
    },
