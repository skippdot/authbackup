    "If you lose this device, a backup file is the way back to your accounts.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если устройство потеряется, вернуть доступ к аккаунтам поможет файл бэкапа."
          }
        }
      }
    },
    "Invalid counter: %@.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверный счётчик: %@."
