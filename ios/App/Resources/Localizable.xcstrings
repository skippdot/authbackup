          }
        }
      }
    },
    "Scan the QR code a website shows when you turn on two-factor authentication, or bring your keys over from Google Authenticator or the AuthBackup browser extension.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте QR-код, который сайт показывает при включении двухфакторной аутентификации, или перенесите ключи из Google Authenticator или браузерного расширения AuthBackup."
          }
        }
      }
    },
    "Scanned %lld of %lld. Show the next QR code.": {
      "localizations": {
