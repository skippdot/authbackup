            "state": "translated",
            "value": "QR-код экспорта повреждён или неполон."
          }
        }
      }
    },
    "The export link has no data.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ссылке экспорта нет данных."
          }
        }
