    },
    "This is not a two-factor key or a Google Authenticator export.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не ключ двухфакторной аутентификации и не экспорт Google Authenticator."
          }
        }
      }
    },
    "This is not an AuthBackup backup file.": {
      "localizations": {
